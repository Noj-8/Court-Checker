# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Env files
.env*.local
.env

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel
.vercel

# Python (already exists, but adding for completeness)
__pycache__/
*.pyc
.venv/

# OS
.DS_Store

# The bot's own Crystal Sports login session (live cookies) — never commit.
# The .tmp pattern covers the atomic-write temp file next to it.
.bot_session.json
.bot_session.*.tmp
# The Mac's copy after seal_session.py handed the session to GitHub Actions.
.bot_session.json.handed-off-*

# Raw pages saved from the live booking site (personal data) — never commit.
# Scrubbed copies for tests live in tests/fixtures/.
fixtures_raw/

# monitor.py's atomic state.json write (temp file) and an unreadable state.json kept aside
.state.json.*.tmp
state.json.unreadable-*
.state_alert.json

# =============================================================================
# Environment variables for the dashboard UI
# Copy this file and set in Vercel's project Settings → Environment Variables.
# Do NOT commit any file containing real values.
# =============================================================================

# Your GitHub username (the owner of the Court-Checker repo)
GITHUB_OWNER=Noj-8

# Your repo name
GITHUB_REPO=Court-Checker

# A fine-grained Personal Access Token scoped to ONLY this repo
# Permissions: Contents (Read & Write), Secrets (Read & Write), Metadata (Read)
GITHUB_TOKEN=ghp_xxx

# OAuth App credentials — create at github.com/settings/developers
GITHUB_OAUTH_CLIENT_ID=xxx
GITHUB_OAUTH_CLIENT_SECRET=xxx

# A random string for NextAuth session encryption.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=xxx

# Your Vercel production URL — set after first deploy.
NEXTAUTH_URL=https://court-checker.vercel.app

# Comma-separated list of GitHub usernames allowed to sign in.
# Leave empty to allow anyone (NOT recommended).
ALLOWED_GITHUB_USERS=Noj-8
